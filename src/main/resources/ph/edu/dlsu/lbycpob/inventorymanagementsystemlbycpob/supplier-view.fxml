<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ph.edu.dlsu.lbycpob.inventorymanagementsystemlbycpob.controller.SupplierController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <TableView fx:id="supplierTable" prefHeight="200.0">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name"/>
            <TableColumn fx:id="emailColumn" text="Email"/>
            <TableColumn fx:id="phoneColumn" text="Phone"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="5.0">
        <TextField fx:id="nameField" promptText="Name"/>
        <TextField fx:id="emailField" promptText="Email"/>
        <TextField fx:id="phoneField" promptText="Phone"/>
    </HBox>

    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="addSupplierButton" text="Add Supplier" onAction="#onAddSupplierButtonClick"/>
        <Button fx:id="updateSupplierButton" text="Update Selected" onAction="#onUpdateSupplierButtonClick"/>
        <Button fx:id="backButton" text="Back to Dashboard" onAction="#onBackButtonClick"/>
    </HBox>
</VBox>
