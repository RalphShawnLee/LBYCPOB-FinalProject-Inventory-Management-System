<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ph.edu.dlsu.lbycpob.inventorymanagementsystemlbycpob.controller.StockMovementController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <TableView fx:id="stockMovementTable" prefHeight="250.0">
        <columns>
            <TableColumn fx:id="productColumn" text="Product"/>
            <TableColumn fx:id="typeColumn" text="Type"/>
            <TableColumn fx:id="quantityColumn" text="Quantity"/>
            <TableColumn fx:id="referenceColumn" text="Reference"/>
            <TableColumn fx:id="timestampColumn" text="Timestamp"/>
        </columns>
    </TableView>

    <Button fx:id="backButton" text="Back to Dashboard" onAction="#onBackButtonClick"/>
</VBox>
