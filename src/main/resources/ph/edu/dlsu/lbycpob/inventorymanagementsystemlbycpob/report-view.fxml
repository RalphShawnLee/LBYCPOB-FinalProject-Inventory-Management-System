<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ph.edu.dlsu.lbycpob.inventorymanagementsystemlbycpob.controller.ReportController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="summaryLabel" text="Top = fast-moving, bottom = slow-moving"/>
    <TableView fx:id="movementSummaryTable" prefHeight="250.0">
        <columns>
            <TableColumn fx:id="productColumn" text="Product"/>
            <TableColumn fx:id="totalOutQuantityColumn" text="Total Sold"/>
        </columns>
    </TableView>

    <Button fx:id="generateReportButton" text="Generate Report" onAction="#onGenerateReportButtonClick"/>
    <Button fx:id="backButton" text="Back to Dashboard" onAction="#onBackButtonClick"/>
</VBox>
