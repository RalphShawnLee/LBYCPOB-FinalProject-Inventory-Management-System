<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ph.edu.dlsu.lbycpob.inventorymanagementsystemlbycpob.controller.ProductController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <TableView fx:id="productTable" prefHeight="200.0">
        <columns>
            <TableColumn fx:id="skuColumn" text="SKU"/>
            <TableColumn fx:id="nameColumn" text="Name"/>
            <TableColumn fx:id="categoryColumn" text="Category"/>
            <TableColumn fx:id="priceColumn" text="Price"/>
            <TableColumn fx:id="quantityColumn" text="Quantity"/>
            <TableColumn fx:id="reorderThresholdColumn" text="Reorder Threshold"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="5.0">
        <TextField fx:id="skuField" promptText="SKU"/>
        <TextField fx:id="nameField" promptText="Name"/>
        <TextField fx:id="categoryField" promptText="Category"/>
        <TextField fx:id="priceField" promptText="Price"/>
        <TextField fx:id="quantityField" promptText="Quantity"/>
        <TextField fx:id="reorderThresholdField" promptText="Reorder Threshold"/>
    </HBox>

    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="addProductButton" text="Add Product" onAction="#onAddProductButtonClick"/>
        <Button fx:id="updateProductButton" text="Update Selected" onAction="#onUpdateProductButtonClick"/>
        <Button fx:id="backButton" text="Back to Dashboard" onAction="#onBackButtonClick"/>
    </HBox>
</VBox>
